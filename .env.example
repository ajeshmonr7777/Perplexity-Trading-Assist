# Perplexity Trading System - Environment Variables

# Perplexity API Key (REQUIRED)
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_api_key_here

# FRED API Key (OPTIONAL - for macro economic features)
# Get FREE API key from: https://fred.stlouisfed.org/
# Leave empty to disable macro features in AI analysis
# When disabled, AI will focus only on technical analysis
FRED_API_KEY=
